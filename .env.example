# ─────────────────────────────────────────────────────────────
#  .env.example — Copy to .env and fill in your values
#  For Railway: set these as environment variables in the dashboard
# ─────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 Credentials (REQUIRED) ──────────────────
# https://console.cloud.google.com/ → Enable YouTube Data API v3
# → Credentials → OAuth 2.0 Client ID (Web application type for cloud)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ── App URL (REQUIRED for cloud deployment) ───────────────────
# Set this to your Railway app URL after deploying
# Example: https://insta-yt-bot.railway.app
APP_URL=http://localhost:5000

# ── Flask Session Secret (REQUIRED for cloud) ─────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_string

# ── YouTube Token (auto-populated after first OAuth) ──────────
# After connecting YouTube, copy the token JSON shown and paste here
# This keeps you logged in across Railway restarts
GOOGLE_TOKEN_JSON=

# ── YouTube Upload Defaults (optional) ───────────────────────
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=22

# ── Environment ───────────────────────────────────────────────
# Set to "production" on Railway, leave as "development" locally
APP_ENV=development
